PARALLEL_API_KEY=your_parallel_api_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud alternative: leave GEMINI_API_KEY empty and use ADC.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-credentials.json

# Shared invite gate; all three are required (no open fallback).
ACCESS_CODE=
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
