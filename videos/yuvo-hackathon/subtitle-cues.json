[
  {
    "start": 0.6,
    "end": 2.08,
    "text": "An empty corridor."
  },
  {
    "start": 2.48,
    "end": 4.359999999999999,
    "text": "Or the start of a mystery?"
  },
  {
    "start": 4.739999999999999,
    "end": 5.819999999999999,
    "text": "Meet Yuvo."
  },
  {
    "start": 7.4,
    "end": 12.36,
    "text": "Start with an idea: a woman can talk to abandoned buildings."
  },
  {
    "start": 12.8,
    "end": 14.77,
    "text": "Their memories are incomplete."
  },
  {
    "start": 15.4,
    "end": 17.39,
    "text": "Gemini plans the research."
  },
  {
    "start": 17.78,
    "end": 20.46,
    "text": "Parallel searches nearby stories and audience reactions,"
  },
  {
    "start": 20.48,
    "end": 22.740000000000002,
    "text": "so you’re building on evidence."
  },
  {
    "start": 27.4,
    "end": 29.549999999999997,
    "text": "Eleven sources. One useful direction:"
  },
  {
    "start": 29.89,
    "end": 34.239999999999995,
    "text": "let the building’s damage shape what it remembers."
  },
  {
    "start": 34.79,
    "end": 36.89,
    "text": "Open the research behind the idea."
  },
  {
    "start": 37.17,
    "end": 39.44,
    "text": "Then make your own creative decision."
  },
  {
    "start": 41.4,
    "end": 44.16,
    "text": "Now, agentic video understanding."
  },
  {
    "start": 44.64,
    "end": 46,
    "text": "Attach a real cut."
  },
  {
    "start": 46.56,
    "end": 49.36,
    "text": "Gemini checks the frames against your premise."
  },
  {
    "start": 49.76,
    "end": 51.879999999999995,
    "text": "It sees the abandoned setting,"
  },
  {
    "start": 52,
    "end": 54,
    "text": "but catches the missing protagonist."
  },
  {
    "start": 54.48,
    "end": 55.56,
    "text": "Click a timestamp."
  },
  {
    "start": 55.879999999999995,
    "end": 57.08,
    "text": "See exactly what it means."
  },
  {
    "start": 62.449999999999996,
    "end": 64.61,
    "text": "Let’s iterate. We add a deadline"
  },
  {
    "start": 64.61,
    "end": 67.49,
    "text": "and two conflicting memories to the same footage."
  },
  {
    "start": 67.88,
    "end": 69.28999999999999,
    "text": "Upload the new cut."
  },
  {
    "start": 70.14,
    "end": 72.99,
    "text": "Gemini compares both videos."
  },
  {
    "start": 73.27,
    "end": 75.03,
    "text": "It spots the new text,"
  },
  {
    "start": 75.03,
    "end": 77.39,
    "text": "and tells us what still needs work:"
  },
  {
    "start": 77.6,
    "end": 80.46,
    "text": "show the woman interacting with the building."
  },
  {
    "start": 80.7,
    "end": 83.12,
    "text": "That’s a specific shot we can make next."
  },
  {
    "start": 86.4,
    "end": 88.62,
    "text": "Idea. Evidence. Cut."
  },
  {
    "start": 88.98,
    "end": 90.94000000000001,
    "text": "A clear next move."
  },
  {
    "start": 91.36,
    "end": 94.22,
    "text": "Powered by Gemini, Parallel, and Google Cloud Run."
  },
  {
    "start": 94.92,
    "end": 98.18,
    "text": "Yuvo. Big idea. Better story."
  }
]
